%===================%
% Jackson Rubiano's Resume %
%===================%

%\numberedPages % NOTE: lastpage requires a second build
%\documentFooter{\thepage of 2} % Does similar without using lastpage
\begin{document}

  %---------%
  % Heading %
  %---------%

  \documentTitle{<%- latexEscape(name) %>}{
    \href{tel:9258909065}{
      \raisebox{-0.05\height} \faPhone\ <%- latexEscape(contact.phone) %>} ~|~
    \href{mailto:jtr029@bucknell.edu}{
      \raisebox{-0.15\height} \faEnvelope\ <%- latexEscape(contact.email) %>} ~|~
    \href{https://linkedin.com/in/jackson-rubiano/}{
      \raisebox{-0.15\height} \faLinkedin\ <%- latexEscape(contact.linkedin) %>} ~|~
    \href{https://github.com/Swimotter}{
      \raisebox{-0.15\height} \faGithub\ <%- latexEscape(contact.github) %>} ~|~
    \href{https://jacksonrubiano.com}{
      \raisebox{-0.15\height} \faGithub\ <%- latexEscape(contact.website) %>}
  }


  %-----------%
  % Education %
  %-----------%

  \section{Education}
  <% education.forEach(school => { %>
    \headingBf{<%- latexEscape(school.school) %>}{<%- latexEscape(school.graduation) %>} % Note: Adding year(s) exposes an implied age
    \headingIt{<%- latexEscape(school.degree) %>}{}
    % \headingIt{Minors: Networking ; Network Security}{}
    \heading{<%- latexEscape(school.gpa) %> GPA, <%- latexEscape(school.egpa) %> Engineering GPA, <%- latexEscape(school.awards.join(", ")) %>}{}
    \heading{Coursework: <%- latexEscape(school.coursework.join(", ")) %>}
  <% }) %>


  %------------%
  % Experience %
  %------------%

  \section{Work Experience}
  <% experience.forEach(job => { %>
    \headingBf{<%- latexEscape(job.company) %> \texttt{|} <%- latexEscape(job.location) %>}{<%- latexEscape(job.start_date) %> -- <%- latexEscape(job.end_date) %>}
    \headingIt{<%- latexEscape(job.title) %>}{}
    \begin{resume_list}
      <% job.bullets.forEach(bullet => { %>
        \item <%- latexEscape(bullet) %>
      <% }) %>
    \end{resume_list}
  <% }) %>


  %----------------------------%
  % Extracurricular Activities %
  %----------------------------%

  \section{Projects and Activities}
  <% projects.forEach(project => { %>
    \headingBf{<%- latexEscape(project.name) %> \texttt{|} <%- latexEscape(project.location) %>}{<%- latexEscape(project.start_date) %> -- <%- latexEscape(project.end_date) %>}
    \headingIt{<%- latexEscape(project.title) %>}{}
    \begin{resume_list}
      <% project.bullets.forEach(bullet => { %>
        \item <%- latexEscape(bullet) %>
      <% }) %>
    \end{resume_list}
  <% }) %>


  %--------%
  % Skills %
  %--------%

  \section{Technical Skills}
  \begin{itemize}[itemsep=-2px, parsep=1pt, leftmargin=75pt]
    <% Object.keys(skills).forEach(type => { %>
      <% const items = skills[type]; %>
      \item[\textbf{<%- latexEscape(type.charAt(0).toUpperCase() + type.slice(1)) %>}] <%- latexEscape(items.join(", ")) %>
    <% }) %>
  \end{itemize}
\end{document}
